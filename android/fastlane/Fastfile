default_platform(:android)

platform :android do
  desc "Build the app bundle and upload it to the Play Store internal track"
  lane :internal do
    Dir.chdir("../..") do
      # No baked-in backend: the store app must NOT pin a backend. A fresh install asks
      # for the server URL on first launch, so no HINATA_DEFAULT_SERVER define.
      sh("flutter", "build", "appbundle", "--release")
    end
    # SUBMIT=true publishes to production (Play auto-reviews it, then rolls out);
    # otherwise it lands on the internal track as a draft to finish by hand.
    submit = ENV["SUBMIT"] == "true"
    upload_to_play_store(
      json_key_data: ENV["PLAY_JSON_KEY"], # Play service account JSON (secret)
      track: submit ? "production" : "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      release_status: submit ? "completed" : "draft",
      # The store listing (title, short/full description, feature graphic, icon,
      # screenshots) is GLOBAL on Play — it is not scoped to a track. Pushing it
      # from the tester channel would republish the public listing, and send it
      # through Google's listing review, on every "Release (button)" press. So
      # only the publish run touches it; this mirrors the Apple side, where
      # `beta` uploads the binary and `release` owns the listing.
      skip_upload_metadata: !submit,
      skip_upload_images: !submit,
      skip_upload_screenshots: !submit,
      # Changelogs stay on for both: they are per versionCode, land on the track
      # being written, and internal testers should see what's new. Absent for a
      # Release-button build (only the publish flow generates them) — supply then
      # simply has nothing to upload for that code.
      skip_upload_changelogs: false,
      # Don't let a missing optional image (e.g. a 7" tablet set) abort the run.
      sync_image_upload: false
    )
  end

  desc "Promote the latest internal build to production"
  lane :promote do
    upload_to_play_store(
      json_key_data: ENV["PLAY_JSON_KEY"], # Play service account JSON (secret)
      track: "internal",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
