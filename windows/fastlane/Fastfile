# Hinata — Windows (Microsoft Store) release automation.
#
# Fastlane has no native Windows/Store actions, so these lanes shell out to the
# platform tooling (msix pub package + Microsoft Store Developer CLI). They exist
# anyway so CI has ONE interface across all platforms — `bundle exec fastlane
# <lane>` — and one place for the preflight checks.
#
#   bundle exec fastlane windows verify    # preflight (no build, no upload)
#   bundle exec fastlane windows build     # flutter build + MSIX package
#   bundle exec fastlane windows release   # build + publish to Partner Center
#
# Store specifics that shape this file:
#   * The MSIX version's 4th field (revision) is RESERVED by the Store and must
#     be 0. pubspec's build number (`+72`) therefore cannot go there — the
#     version is composed as X.Y.Z.0 and uniqueness comes from the version bump
#     that "Publish (button)" performs on every run.
#   * The Store signs Store-bound packages itself on ingestion, so CI needs no
#     code-signing certificate. Only side-loaded MSIX would.
#   * `msstore publish` UPDATES an existing, already-live listing. The very first
#     submission is manual — see release/MANUAL_STEPS_WINDOWS.md.

default_platform(:windows)

APP_IDENTITY = "4hm4dr3.hinata".freeze

# Store product ID (Partner Center → Product identity → "Store ID"). It is public
# — it is the id in https://apps.microsoft.com/detail/9N5NVNPKBBLR — so it lives
# here instead of in a secret. MSSTORE_PRODUCT_ID overrides it if ever needed.
STORE_PRODUCT_ID = "9N5NVNPKBBLR".freeze

# Entra Application (client) ID of the `hinata-wns` registration. Goes into the
# manifest's COM activator class id so WNS can activate the app for background
# push. Public identity, not a credential — the secret lives in the gateway.
AZURE_APP_ID = "e89a5a67-af01-4c79-98a7-09e609f0c831".freeze

def repo_root
  File.expand_path("../..", __dir__)
end

def flutter(*args)
  Dir.chdir(repo_root) { sh("flutter", *args) }
end

def dart(*args)
  Dir.chdir(repo_root) { sh("dart", *args) }
end

# pubspec `version: 7.0.0+72` → ["7.0.0", "72"]
def pubspec_version
  line = File.readlines(File.join(repo_root, "pubspec.yaml"))
             .find { |l| l.start_with?("version:") }
  UI.user_error!("No `version:` in pubspec.yaml") unless line
  name, code = line.sub("version:", "").strip.split("+")
  [name, code]
end

# Store-legal MSIX version: X.Y.Z.0 (revision reserved by the Store).
def msix_version
  name, = pubspec_version
  UI.user_error!("Version '#{name}' is not X.Y.Z") unless name.match?(/\A\d+\.\d+\.\d+\z/)
  "#{name}.0"
end

def msix_path
  File.join(repo_root, "build", "windows", "x64", "runner", "Release", "hinata.msix")
end

def product_id
  id = ENV["MSSTORE_PRODUCT_ID"].to_s
  id.empty? ? STORE_PRODUCT_ID : id
end

platform :windows do
  desc "Preflight: version format, msix_config, capability register, product id"
  lane :verify do
    pubspec = File.read(File.join(repo_root, "pubspec.yaml"))
    UI.user_error!("pubspec.yaml has no msix_config block") unless pubspec.include?("msix_config:")

    version = msix_version
    UI.message("MSIX version will be #{version} (revision field is Store-reserved)")

    # Capabilities declared for packaging must all be in the permission register.
    register = File.read(File.join(repo_root, "release", "permissions.yaml"))
    caps = pubspec[/^\s*capabilities:\s*(.+)$/, 1].to_s.split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("msix_config declares no capabilities") if caps.empty?
    missing = caps.reject { |c| register.include?(c) }
    unless missing.empty?
      UI.user_error!(
        "Capabilities not in release/permissions.yaml: #{missing.join(', ')}.\n" \
        "Every capability needs a documented feature + rationale before submission."
      )
    end
    UI.success("Capabilities registered: #{caps.join(', ')}")

    UI.success("Store product: #{product_id}")
  end

  desc "Build the release binary and package it as a Store MSIX"
  lane :build do
    verify
    # No baked-in backend: the store app must NOT pin a server. A fresh install
    # asks for the URL on first launch (same rule as the macOS/iOS lanes).
    flutter("build", "windows", "--release")
    # Three steps rather than `msix:create`, because the generated manifest has
    # to be patched in between: the msix package offers no hook for the COM
    # activator and framework dependency that Windows App SDK push requires,
    # but it does split building from packing.
    dart("run", "msix:build", "--store", "--version", msix_version)
    dart("run", "tool/patch_msix_manifest.dart",
         "--app-id=#{AZURE_APP_ID}", "--runtime=2")
    dart("run", "msix:pack", "--store", "--version", msix_version)
    UI.user_error!("MSIX not found at #{msix_path}") unless File.exist?(msix_path)
    UI.success("Packaged #{msix_path}")
  end

  desc "Build + upload to Partner Center. SUBMIT=true also commits the submission."
  lane :release do
    build

    # The msstore CLI is installed and authenticated by the workflow
    # (microsoft/microsoft-store-apppublisher + `msstore reconfigure`).
    # Note: this UPDATES an existing, already-live listing — the first
    # submission is manual, see release/MANUAL_STEPS_WINDOWS.md.
    #
    # `publish` COMMITS the submission on its own; --noCommit is what leaves it
    # a draft. So this single call already starts certification, and the
    # `submission publish` that used to follow it was not a second stage — it
    # tried to commit an already-committed submission and died on "This
    # submission is in certification", painting a successful release red.
    args = ["publish", msix_path, "-id", product_id]
    args << "--noCommit" unless ENV["SUBMIT"] == "true"
    sh("msstore", *args)

    if ENV["SUBMIT"] == "true"
      UI.success("Submission committed — Partner Center certification starts now.")
    else
      UI.success("Package uploaded as a draft submission (not committed).")
    end
  end
end
