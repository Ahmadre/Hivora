# Hinata — iOS release automation.
#
# Auth is always via an App Store Connect API key (no Apple ID / 2FA). Signing
# assets live in the shared match repo (see Matchfile). Build numbers are derived
# from the latest TestFlight build, so you never bump them by hand.
#
#   bundle exec fastlane ios bootstrap   # one-time: create App ID + certs/profiles
#   bundle exec fastlane ios signing     # fetch certs/profiles (read-only on CI)
#   bundle exec fastlane ios beta        # build + upload to TestFlight
#   bundle exec fastlane ios release     # build + submit to the App Store

default_platform(:ios)

# gym probes `xcodebuild -showBuildSettings` before archiving. On a cold CI
# runner the very first xcodebuild invocation resolves the workspace/SPM state
# and can take minutes; fastlane's 3s default timeout then fails the lane.
# `||=` keeps an explicit override from the environment authoritative.
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] ||= "6"

APP_IDENTIFIER = "com.ahmadre.hinata".freeze
WORKSPACE = "Runner.xcworkspace".freeze
SCHEME = "Runner".freeze
IPA_DIR = "../build/ios/ipa".freeze
IPA_NAME = "hinata.ipa".freeze

def ci?
  ENV["CI"] == "true"
end

# App Store Connect refuses to create a new version or to hand out an editable
# "App Info" while an earlier version is still Waiting for Review / In Review /
# Pending Developer Release. App Info (name, subtitle, privacy URL) belongs to
# the app RECORD, not to a platform — so a pending macOS version blocks the iOS
# metadata upload just as well. Nothing in the pipeline can work around that;
# the only fix is to unblock the app in App Store Connect.
LOCKED_APP_HINT = <<~MSG.freeze
  App Store Connect has no editable state for #{APP_IDENTIFIER} right now.

  This happens when a version (iOS *or* macOS — they share one app record and
  therefore one App Info) is still "Waiting for Review", "In Review" or
  "Pending Developer Release". While that lasts, no new version can be created
  and the localized App Info is read-only.

  To unblock: in App Store Connect either release the approved version, or
  cancel/reject the pending submission — then re-run "Publish (button)".

  Uploading a build is NOT affected: "Release (button)" goes to TestFlight and
  keeps working in this state.
MSG

def locked_app_error?(error)
  error.message.to_s.match?(
    /editable 'App Info'|cannot create a new version of the app|in the current state/i
  )
end

# Sets the global App Store Connect API key so every subsequent action (match,
# cert, sigh, pilot, deliver) authenticates without an Apple ID / 2FA. Locally it
# reads the .p8 file (HINATA_ASC_KEY_PATH); on CI the base64 contents
# (APP_STORE_CONNECT_API_KEY_CONTENT). We never pass the key on to nested actions
# (that triggers an api_key/api_key_path conflict in `cert`) — they pick it up
# from the lane context automatically.
def auth!
  path = ENV["HINATA_ASC_KEY_PATH"]
  # Resolve a relative .p8 path against the fastlane dir, independent of CWD.
  path = File.expand_path(path, __dir__) if path && !path.start_with?("/")
  common = {
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"]
  }
  if path && File.exist?(path)
    app_store_connect_api_key(**common, key_filepath: path)
  else
    app_store_connect_api_key(**common,
                              key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
                              is_key_content_base64: true)
  end
end

# Next build number = (latest TestFlight build for this platform) + 1.
def next_build_number
  latest = begin
    latest_testflight_build_number(app_identifier: APP_IDENTIFIER, platform: "ios")
  rescue StandardError
    0
  end
  latest.to_i + 1
end

# Run a flutter command from the repo root (fastlane runs inside ios/).
def flutter(*args)
  Dir.chdir("../..") { sh("flutter", *args) }
end

platform :ios do
  before_all do
    setup_ci if ci? # ephemeral keychain so match can install the certs
  end

  desc "One-time: create the dev + App Store signing assets in the match repo"
  lane :bootstrap do
    auth!
    # The App ID + App Store Connect record already exist; match just needs to
    # create/fetch the certificates + provisioning profiles and push them
    # (encrypted) to the certificates repo. Run `asc_app` only if you ever need
    # to (re)create the App Store Connect record.
    match(type: "development", app_identifier: APP_IDENTIFIER, readonly: false)
    match(type: "appstore", app_identifier: APP_IDENTIFIER, readonly: false)
    UI.success("iOS signing assets are in the match repo. CI can now run read-only.")
  end

  desc "Create the App Store Connect app record (name must be globally unique)"
  lane :asc_app do |options|
    auth!
    produce(
      app_identifier: APP_IDENTIFIER,
      app_name: options[:name] || "Hinata",
      language: "English",
      skip_devcenter: true
    )
  end

  desc "Fetch signing certificates & profiles (read-only on CI)"
  lane :signing do
    auth!
    match(type: "development", app_identifier: APP_IDENTIFIER, readonly: ci?)
    match(type: "appstore", app_identifier: APP_IDENTIFIER, readonly: ci?)
  end

  desc "Build a signed App Store IPA"
  lane :build do
    auth!
    match(type: "appstore", app_identifier: APP_IDENTIFIER, readonly: ci?)

    # Pin the Runner target to the App Store profile match just installed, by its
    # actual name (the project otherwise hardcodes a profile name whose ID drifts
    # on every regeneration). This makes the archive use the App Store profile
    # directly, so no development profile is needed.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "T852K29HWS",
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_IDENTIFIER]
    )

    # Bake the Dart/asset bundle + the resolved build number into the Xcode
    # config; gym then archives, signs and exports the IPA.
    # No baked-in backend: the store app must NOT pin a backend. A fresh install asks
    # for the server URL on first launch, so no HINATA_DEFAULT_SERVER define.
    flutter("build", "ios", "--release", "--no-codesign",
            "--build-number=#{next_build_number}")

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      output_directory: IPA_DIR,
      output_name: IPA_NAME,
      export_options: {
        # Use the exact profile name match just installed (handles any suffix).
        provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      ipa: "#{IPA_DIR}/#{IPA_NAME}",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build + upload binary & metadata to App Store Connect. SUBMIT=true also submits for review."
  #
  # This lane needs the app to be EDITABLE on App Store Connect: deliver creates
  # the new App Store version and rewrites the App Info localizations. Use it for
  # the "Publish (button)" flow only — plain TestFlight drops go through `beta`,
  # which has no such requirement.
  lane :release do
    build
    submit = ENV["SUBMIT"] == "true"
    upload_to_app_store(
      ipa: "#{IPA_DIR}/#{IPA_NAME}",
      submit_for_review: submit,  # SUBMIT=true → auto-submit; else upload a draft
      automatic_release: false,   # you still control the go-live after approval
      submission_information: submit ? { add_id_info_uses_idfa: false } : nil,
      force: true,                # no HTML preview / confirmation on CI
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      # Upload the localized listing (fastlane/metadata: name, subtitle, keywords,
      # description, promo, what's-new, URLs, copyright, categories, review info).
      skip_metadata: false,
      # Screenshots are NOT part of a release — see the `screenshots` lane below
      # for why `overwrite_screenshots` cannot keep them duplicate-free.
      skip_screenshots: true,
      # deliver keeps retrying while it waits for App Store Connect to settle.
      # The default of 7 backs off up to ~20 minutes before it gives up — far too
      # long when the app is simply locked and no amount of waiting will help.
      # Two attempts still absorb a genuine transient hiccup.
      version_check_wait_retry_limit: 2
    )
  rescue StandardError => e
    raise unless locked_app_error?(e)
    UI.error(e.message)
    UI.user_error!(LOCKED_APP_HINT)
  end

  desc "Sync fastlane/screenshots to App Store Connect (run by hand when they change)"
  #
  # Why this is a separate, opt-in lane instead of part of `release`:
  #
  # `overwrite_screenshots` is a ONE-SHOT pre-clean — deliver deletes the remote
  # screenshot sets once, before uploading, and never again. The duplicates come
  # from what happens AFTER that, inside deliver's own retry loop:
  #   1. `retry_upload_screenshots_if_needed` retries whenever it believes a local
  #      screenshot is missing remotely.
  #   2. That check (and the per-file duplicate guard in `upload_screenshots`)
  #      matches on `AppScreenshot#source_file_checksum`. App Store Connect
  #      regularly returns that as nil for API-uploaded assets.
  #   3. nil never equals the local MD5 → deliver concludes nothing arrived.
  #   4. Before retrying it deletes only screenshots that are NOT `complete?` —
  #      so the ones that really did upload survive and the same file is pushed
  #      on top of them. Up to 5 tries → the same shot 2×, 3× …
  # `overwrite_screenshots` is powerless against that; it already ran.
  #
  # `sync_screenshots` uses a different code path: it diffs
  # `locale/filename/checksum` between local and remote and deletes every remote
  # entry without a local match. A nil checksum then makes the remote entry a
  # DELETE candidate rather than an extra upload, so the result converges on
  # exactly the local set no matter how often the lane runs.
  #
  #   bundle exec fastlane ios screenshots
  lane :screenshots do
    auth!
    # Screenshots live on the editable App Store version, so there has to be one.
    # Checking up-front turns "undefined method `version_string' for nil" into an
    # actionable message.
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    unless app&.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform.map("ios"))
      UI.user_error!(LOCKED_APP_HINT)
    end

    # sync_screenshots is still behind fastlane's beta feature flag.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"
    upload_to_app_store(
      # Screenshots only: no binary, and skip_metadata keeps deliver away from the
      # App Info localizations (that is the part that needs an unlocked app).
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      sync_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
